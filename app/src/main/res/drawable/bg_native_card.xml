<?xml version="1.0" encoding="utf-8"?>
<!-- Native ad container. Matches VidsizeCard: white surface, hairline border,
     26dp radius — so the ad reads as a Vidsize-quality card, while the "Ad"
     badge and AdChoices keep it unmistakably an advertisement. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/vidsize_surface" />
    <stroke android:width="1dp" android:color="@color/vidsize_border" />
    <corners android:radius="26dp" />
</shape>
