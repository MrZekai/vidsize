.gradle/
.idea/
local.properties
**/build/
*.iml
.DS_Store
captures/
.externalNativeBuild/
.cxx/

# Google Play upload signing material - NEVER commit private keys.
.signing/
**/vidsize-play-upload.jks
**/vidsize-play-upload.keystore
**/vidsize-play-upload.p12

# AdMob identifiers. Not secret - they ship inside the APK - but kept out of the
# repository so a clone with no identifiers packages with ads OFF and still
# builds. That is what lets CI publish an unsigned audit AAB nobody can turn the
# ads SDK on in. See docs/ADS.md.
ads.properties

# Python bytecode from the tools/ checkers.
#
# tools/check_kotlin_syntax.py imports strip_noise from
# tools/check_kotlin_references.py. Importing a module - as opposed to running
# it as a script - makes CPython write tools/__pycache__/<name>.cpython-XX.pyc.
# Run 34890837352 passed every gate and still failed on that single untracked
# file, because the negative-test step ends by asserting the working tree is
# exactly as checked out before the source audit ZIP is cut.
#
# The assertion was right; the tree really was not clean. Generated bytecode is
# not source and must never reach a commit or an audit ZIP.
__pycache__/
*.py[cod]

# The audit ZIP is produced by CI from `git archive HEAD`. A committed copy
# would be a stale duplicate of the very thing it is meant to attest to.
vidsize-v*-source-audit.zip
